# ===== Server =====
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM (OpenAI 兼容协议) =====
# 敏感项（LLM_BASE_URL / LLM_API_KEY）推荐通过环境变量注入：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 环境变量优先于本文件；本文件仅作为本地开发兜底，已被 gitignore，勿提交真实密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen3-max

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 DATA_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shopcross_products

# ===== Reranker（空 = 降级为按向量分排序，rerank_applied=false） =====
# qwen3.7-text-rerank：填写百炼业务空间根地址，不要带 /api/v1
# RERANKER_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com
# RERANKER_MODEL=qwen3.7-text-rerank

# ===== Web 搜索 Tavily（空 = 不注册 web_search_tool） =====
# TAVILY_API_KEY=tvly-xxx

# ===== 可观测（空 = 不启用 TracingMiddleware） =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ===== Langfuse（空 = 不启用；自托管平台启动见 scripts/start_langfuse.ps1） =====
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_ENVIRONMENT=local
