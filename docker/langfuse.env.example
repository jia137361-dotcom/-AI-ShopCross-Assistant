# 自托管 Langfuse 的本地开发配置。首次启动脚本会生成同目录 langfuse.env。
# 生产环境请替换全部随机密钥，并通过密钥管理系统注入。
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false

# Langfuse Web UI 首次启动后可自行注册账号、创建 AI ShopCross Assistant 项目并生成 Key。
# 生成后填回项目根目录 .env：
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
